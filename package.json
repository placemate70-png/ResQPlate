{
  "name": "resqplate",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b",
    "test:logic": "node tests/foodLogic.mjs",
    "test:phase2": "node --env-file=.env.local --env-file=.env.test.local tests/phase2.mjs",
    "test:phase1": "node --env-file=.env.local --env-file=.env.test.local tests/phase1.mjs",
    "test:expiry": "node --env-file=.env.local --env-file=.env.test.local tests/expiry.mjs",
    "test:fcfs": "node --env-file=.env.local --env-file=.env.test.local tests/fcfs.mjs",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "leaflet": "^1.9.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
